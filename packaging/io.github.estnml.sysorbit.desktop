[Desktop Entry]
Type=Application
Name=Sysorbit
GenericName=Systemd Timer Viewer
GenericName[tr]=Systemd Zamanlayıcı Görüntüleyicisi
Comment=Explore systemd timer schedules and run history
Comment[tr]=Systemd zamanlayıcılarını ve çalışma geçmişini inceleyin
